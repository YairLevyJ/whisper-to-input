        <item>@string/settings_option_transcription_mode_local</item>
        <item>@string/settings_option_transcription_mode_auto</item>
    </string-array>
    <string name="settings_local_model_variant">Local Model</string>
    <string name="settings_local_model_variant_desc">Which on-device Whisper model to use. Larger models are more accurate — especially for languages other than English — but slower and heavier to download.</string>
    <string name="local_model_variant_small">Small (~466 MB) — fastest, lower accuracy</string>
    <string name="local_model_variant_medium">Medium (~1.5 GB) — balanced</string>
    <string name="local_model_variant_large_v3_turbo_q5">Large-v3-turbo, quantized (~547 MB) — recommended: near-large-v3 accuracy, much faster</string>
    <string name="local_model_variant_large_v3_q5">Large-v3, quantized (~1.1 GB) — highest accuracy, heaviest</string>
    <string-array name="settings_local_model_variant_array">
        <item>@string/local_model_variant_small</item>
        <item>@string/local_model_variant_medium</item>
        <item>@string/local_model_variant_large_v3_turbo_q5</item>
