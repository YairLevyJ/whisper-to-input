    </string-array>
    <string name="settings_endpoint">Endpoint</string>
    <string name="settings_endpoint_desc">The host and port for the OpenAI API, Whisper ASR Webservice, or NVIDIA NIM endpoint.</string>
    <string name="settings_endpoint_hint"><![CDATA[e.g., http://<host>:<port>/asr]]></string>
    <string name="settings_language_code">Language Code</string>
    <string name="settings_language_code_desc">The language code to be included in the request payload (e.g., en, zh).</string>
    <string name="settings_language_code_hint">Enter Language Code (e.g., en, zh)</string>
    <string name="settings_api_key">API Key</string>
    <string name="settings_api_key_desc">The official OpenAI API Key to be used in requests.</string>
    <string name="settings_api_key_hint">Enter OpenAI API Key…</string>
    <string name="settings_model">Model</string>
    <string name="settings_model_desc">The model to use for transcription (e.g., whisper-1).</string>
    <string name="settings_model_hint">Enter model name (e.g., whisper-1)</string>
    <string name="settings_prompt">Prompt</string>
    <string name="settings_prompt_desc">Optional context or vocabulary hint sent to the transcription API to bias recognition (e.g., names, jargon, or a sample sentence in the target language). May be left empty.</string>
    <string name="settings_prompt_hint">Enter optional context/vocabulary hint…</string>
    <string name="settings_text_shortcuts">Text Shortcuts</string>
    <string name="settings_text_shortcuts_desc">Replace spoken phrases with fixed text, one per line, formatted as trigger=replacement (e.g., my email=jane@example.com). The trigger is matched as a whole phrase, case-insensitively, anywhere in the transcribed text. May be left empty.</string>
    <string name="settings_text_shortcuts_hint"><![CDATA[my email=jane@example.com]]></string>
    <string name="settings_option_yes">Yes</string>
    <string name="settings_option_no">No</string>
    <string name="settings_auto_stop_recording">Auto Stop Recording</string>
    <string name="settings_auto_stop_recording_desc">Whether to automatically finish recording after a few seconds of silence, and cancel it if speech never starts. Disabled by default.</string>
    <string-array name="settings_auto_stop_recording_array">
        <item>@string/settings_option_yes</item>
        <item>@string/settings_option_no</item>
    </string-array>
    <string name="settings_audio_effects">Microphone Audio Effects</string>
    <string name="settings_audio_effects_desc">Whether to apply the device noise suppressor and automatic gain control while recording, when available. Disabled by default, since these can degrade transcription accuracy.</string>
    <string-array name="settings_audio_effects_array">
        <item>@string/settings_option_yes</item>
        <item>@string/settings_option_no</item>
    </string-array>
    <string name="settings_auto_recording_start">Auto Recording Start</string>
    <string name="settings_auto_recording_start_desc">Whether to automatically start recording upon opening the keyboard.</string>
    <string-array name="settings_auto_recording_start_array">
        <item>@string/settings_option_yes</item>
        <item>@string/settings_option_no</item>
    </string-array>
    <string name="settings_auto_switch_back">Auto Switch Back</string>
    <string name="settings_auto_switch_back_desc">Automatically switch back to the previous keyboard after transcription.</string>
    <string-array name="settings_auto_switch_back_array">
        <item>@string/settings_option_yes</item>
        <item>@string/settings_option_no</item>
    </string-array>
    <string name="settings_add_trailing_space">Add Trailing Space</string>
    <string name="settings_add_trailing_space_desc">Whether to add a trailing space after the transcribed text.</string>
    <string-array name="settings_add_trailing_space_array">
        <item>@string/settings_option_yes</item>
        <item>@string/settings_option_no</item>
    </string-array>

    <!-- Local model -->
    <string name="settings_transcription_mode">Transcription Mode</string>
    <string name="settings_transcription_mode_desc">Whether to transcribe using the network backend above, an on-device local model, or automatically pick whichever is likely faster and fall back to the other one if it fails.</string>
    <string name="settings_option_transcription_mode_api">Network (API)</string>
    <string name="settings_option_transcription_mode_local">Local model</string>
    <string name="settings_option_transcription_mode_auto">Auto</string>
