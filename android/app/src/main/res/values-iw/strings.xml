<?xml version="1.0" encoding="utf-8"?>
<!--
    Hebrew translations. This directory is named values-iw rather than values-he because
    Android resolves Hebrew through the legacy ISO 639-1 code "iw".

    Strings deliberately left untranslated in values/strings.xml: the default endpoint, model
    and language values (they are URLs and identifiers, not prose) and the backend names
    (OpenAI API, Whisper ASR Webservice, NVIDIA NIM), which are product names.
-->
