    <!-- Settings -->
    <string name="whisper_to_input_settings_title">הגדרות QuickDictate</string>
    <string name="settings_btn_apply">החל</string>

    <string name="settings_speech_to_text_backend">שרת המרת דיבור לטקסט</string>
    <string name="settings_speech_to_text_backend_desc">בחירה בין ה-API הרשמי של OpenAI (או שירות תואם, כגון Groq), שרת Whisper ASR Webservice, או NVIDIA NIM.</string>

    <string name="settings_endpoint">כתובת השרת</string>
    <string name="settings_endpoint_desc">כתובת ה-endpoint שאליה נשלחות בקשות התמלול.</string>
    <string name="settings_endpoint_hint"><![CDATA[לדוגמה: http://<host>:<port>/asr]]></string>

    <string name="settings_language_code">קוד שפה</string>
    <string name="settings_language_code_desc">קוד השפה שיישלח בבקשה, כלומר שפת הדיבור שיש לתמלל (לדוגמה: he, en). זו אינה שפת הממשק.</string>
    <string name="settings_language_code_hint">הזן קוד שפה (לדוגמה: he, en)</string>

    <string name="settings_api_key">מפתח API</string>
    <string name="settings_api_key_desc">מפתח ה-API שישמש בבקשות לשרת.</string>
    <string name="settings_api_key_hint">הזן מפתח API…</string>

    <string name="settings_model">מודל</string>
    <string name="settings_model_desc">המודל שישמש לתמלול (לדוגמה: whisper-1).</string>
    <string name="settings_model_hint">הזן שם מודל (לדוגמה: whisper-1)</string>

    <string name="settings_prompt">הקשר</string>
    <string name="settings_prompt_desc">רמז הקשר או אוצר מילים אופציונלי שנשלח לשרת כדי להטות את הזיהוי (לדוגמה: שמות, מונחים מקצועיים, או משפט לדוגמה בשפת היעד). אפשר להשאיר ריק.</string>
    <string name="settings_prompt_hint">הזן רמז הקשר או אוצר מילים…</string>

    <string name="settings_text_shortcuts">קיצורי טקסט</string>
    <string name="settings_text_shortcuts_desc">החלפת ביטויים מדוברים בטקסט קבוע, שורה לכל קיצור, בפורמט קיצור=טקסט_חלופי (לדוגמה: המייל שלי=jane@example.com). הקיצור מזוהה כביטוי שלם, בלי הבדל בין אותיות גדולות לקטנות, בכל מקום בטקסט המתומלל. אפשר להשאיר ריק.</string>
    <string name="settings_text_shortcuts_hint"><![CDATA[המייל שלי=jane@example.com]]></string>

    <string name="settings_option_yes">כן</string>
    <string name="settings_option_no">לא</string>

    <string name="settings_auto_stop_recording">עצירת הקלטה אוטומטית</string>
    <string name="settings_auto_stop_recording_desc">האם לסיים את ההקלטה אוטומטית לאחר מספר שניות של שקט, ולבטל אותה אם לא זוהה דיבור כלל. כבוי כברירת מחדל.</string>

    <string name="settings_audio_effects">אפקטי אודיו של המיקרופון</string>
    <string name="settings_audio_effects_desc">האם להפעיל את מנגנוני הפחתת הרעש ובקרת ההגבר האוטומטית של המכשיר בזמן ההקלטה, אם הם זמינים. כבוי כברירת מחדל, מכיוון שהם עלולים לפגוע בדיוק התמלול.</string>

    <string name="settings_auto_recording_start">התחלת הקלטה אוטומטית</string>
    <string name="settings_auto_recording_start_desc">האם להתחיל להקליט אוטומטית עם פתיחת המקלדת.</string>

    <string name="settings_auto_switch_back">חזרה אוטומטית למקלדת הקודמת</string>
    <string name="settings_auto_switch_back_desc">האם לחזור אוטומטית למקלדת הקודמת בסיום התמלול.</string>

    <string name="settings_add_trailing_space">הוספת רווח בסוף</string>
    <string name="settings_add_trailing_space_desc">האם להוסיף רווח אחרי הטקסט המתומלל.</string>

    <!-- Local model -->
    <string name="settings_transcription_mode">מצב תמלול</string>
    <string name="settings_transcription_mode_desc">האם לתמלל דרך שרת הרשת שהוגדר למעלה, מודל מקומי במכשיר, או לבחור אוטומטית את מה שכנראה יהיה מהיר יותר וליפול חזרה לאפשרות השנייה אם היא נכשלת.</string>
    <string name="settings_option_transcription_mode_api">רשת (API)</string>
    <string name="settings_option_transcription_mode_local">מודל מקומי</string>
    <string name="settings_option_transcription_mode_auto">אוטומטי</string>

    <string name="settings_local_model_variant">מודל מקומי</string>
    <string name="settings_local_model_variant_desc">איזה מודל Whisper מקומי להשתמש בו במכשיר. מודלים גדולים יותר מדויקים יותר — במיוחד בשפות שאינן אנגלית — אך איטיים וכבדים יותר להורדה.</string>
    <string name="local_model_variant_small">Small (‏~466MB) — הכי מהיר, דיוק נמוך יותר</string>
    <string name="local_model_variant_medium">Medium (‏~1.5GB) — איזון בין מהירות לדיוק</string>
    <string name="local_model_variant_large_v3_turbo_q5">Large-v3-turbo, מקוונטז (‏~547MB) — מומלץ: דיוק קרוב ל-large-v3, הרבה יותר מהיר</string>
    <string name="local_model_variant_large_v3_q5">Large-v3, מקוונטז (‏~1.1GB) — הדיוק הגבוה ביותר, הכי כבד</string>

